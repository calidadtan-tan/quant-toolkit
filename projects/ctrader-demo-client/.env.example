# DEMO only. Any other host is refused before a trading request.
# JSON port is fixed at 5036 (wss://demo.ctraderapi.com:5036). It is not configurable.
CTRADER_HOST=demo.ctraderapi.com
CTRADER_ACCOUNT_ID=5360748

# Open API app poteto-demo-sltp is Status=Submitted (not Active).
# Leave the secrets empty until Spotware activates the app and OAuth completes.
# Do not hardcode them in source.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# Redirect URI registered for poteto-demo-sltp. Any other value is refused.
CTRADER_REDIRECT_URI=https://localhost
